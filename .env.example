# ═══════════════════════════════════════════════════════════════════════
# Optimus — Environment Configuration
# Copy to .env and fill in actual values
# ═══════════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────────
# Set this to enable AI-powered schema inference & code generation
# Works with: OpenAI, DeepSeek, Anthropic, Ollama, Qwen, Zhipu
OPTIMUS_LLM_API_KEY=sk-utfCaO6Gj99EyDZFF3g4yFsFKPMUY3LLvZuN0YWDttcolEGIyXjbxDGs7BMuu6Y9

# API base URL (auto-detects provider)
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Anthropic:https://api.anthropic.com/v1
# Ollama:   http://localhost:11434/v1
OPTIMUS_LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Model name
OPTIMUS_LLM_MODEL=deepseek-v4-flash

# Max tokens per LLM call
OPTIMUS_LLM_MAX_TOKENS=250000

# ── Cost Tracking ────────────────────────────────────────────────────
# Cost per 1M tokens in USD (for budget capping)
OPTIMUS_LLM_INPUT_COST=0.10
OPTIMUS_LLM_OUTPUT_COST=0.50

# ── Compilation Loop ─────────────────────────────────────────────────
# Max retries when rustc compilation fails (with LLM fix loop)
OPTIMUS_MAX_COMPILE_RETRIES=10

# Max retries when WASM extraction validation fails
OPTIMUS_MAX_EXTRACTION_RETRIES=5

# Max cost per layout in USD cents (prevents runaway API bills)
OPTIMUS_MAX_COST_PER_LAYOUT=1000

# ── Logging ──────────────────────────────────────────────────────────
# Options: error, warn, info, debug, trace
# Comma-separated module overrides: optimus_core=debug,warn
RUST_LOG=info
